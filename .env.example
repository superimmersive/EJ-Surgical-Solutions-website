# Copy this file to .env and fill in your Transpharm B2B credentials.
#   copy .env.example .env   (Windows)

TRANSPHARM_BASE_URL=https://www.transpharm.co.za
# Mobile number or email — must match what you use at transpharm.co.za/login (OTP is sent here)
TRANSPHARM_USER=your-mobile-or-email
# Not used for OTP login; optional for legacy API attempts
TRANSPHARM_PASSWORD=

# Defaults for Transpharm Spartacus storefront (usually no change needed)
TRANSPHARM_CLIENT_ID=spartacus_client_transpharm
TRANSPHARM_CLIENT_SECRET=secret

TRANSPHARM_CUSTOMER_ID=
TRANSPHARM_REGION=tp_za

# OTP code from SMS/email — step 2 only (npm run transpharm-verify-otp)
TRANSPHARM_OTP=
